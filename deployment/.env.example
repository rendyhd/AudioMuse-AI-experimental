# Copy this file to `.env` and fill in the values that match your setup.
# Docker Compose files under deployment/ read these variables to keep settings in one place.
#
# IMPORTANT: 
# 1. This file must be named exactly ".env" (not .env.txt or .env.example)
# 2. It must be in the SAME directory as your docker-compose-*.yaml file
# 3. Do NOT use spaces around the = sign
# 4. Do NOT use quotes around values (unless required by the value itself)
# 5. After editing, restart containers: docker-compose down && docker-compose up -d
#
# SPECIAL CHARACTERS IN VALUES:
# If your password or API key contains special characters like: $ ` " ' \ # ! & * ( ) [ ] { } | ; < > ?
# you may need to:
#   - Avoid quotes entirely: GEMINI_API_KEY=AIza$pecial!Key  (usually works)
#   - OR use single quotes if the value has $: GEMINI_API_KEY='AIza$pecial!Key'
#   - OR escape with backslash: GEMINI_API_KEY=AIza\$pecial\!Key
# Most problematic characters: $ (variable expansion), ` (command substitution), " (string delimiter)
#
# TROUBLESHOOTING:
# If API keys don't work, verify:
#   - File is named ".env" exactly (check with: ls -la)
#   - No spaces: GEMINI_API_KEY=AIza... (not GEMINI_API_KEY = "AIza...")
#   - No unescaped special characters (especially $ ` " ')
#   - Restart containers after changing this file
# If all else fails, try hardcoding the value directly in docker-compose-*.yaml to isolate the issue

# --- Jellyfin ---
JELLYFIN_USER_ID=YOUR_JELLYFIN_USER_ID
JELLYFIN_TOKEN=YOUR_JELLYFIN_API_TOKEN
JELLYFIN_URL=http://jellyfin.example.com:8096

# --- Emby ---
EMBY_USER_ID=
EMBY_TOKEN=
EMBY_URL=

# --- Navidrome ---
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# --- Lyrion ---
LYRION_URL=http://lyrion.example.com

# --- Plex ---
# Get your Plex token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_URL=http://plex.example.com:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN

# --- Multi-Server Playlist Sync ---
# Enable syncing playlists from primary server to secondary servers.
# Requires all servers to share the same music library mount (identical file paths).
#
# Primary server: The server used for audio analysis (defaults to MEDIASERVER_TYPE if not set)
PLAYLIST_PRIMARY_SERVER=
# Secondary servers: Comma-separated list of servers to sync playlists to
# Example: jellyfin,navidrome (syncs playlists from primary to these servers)
PLAYLIST_SECONDARY_SERVERS=
# Enable/disable playlist sync globally (default: true when secondary servers are configured)
PLAYLIST_SYNC_ENABLED=true

# --- Shared backend configuration ---
POSTGRES_USER=audiomuse
POSTGRES_PASSWORD=audiomusepassword
POSTGRES_DB=audiomusedb
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
REDIS_URL=redis://redis:6379/0

# --- Remote worker integration ---
WORKER_URL=http://worker.example.com:8029/worker
WORKER_POSTGRES_HOST=server.example.com
WORKER_REDIS_URL=redis://server.example.com:6379/0

# --- AI Model Configuration ---
# Choose your AI provider: NONE, OLLAMA, OPENAI, GEMINI, OPENAI, or MISTRAL
AI_MODEL_PROVIDER=NONE

# --- OpenAI / OpenRouter Configuration ---
# For OpenRouter (https://openrouter.ai):
#   1. Get API key from https://openrouter.ai/keys
#   2. Set OPENAI_API_KEY to your OpenRouter API key
#   3. Set OPENAI_SERVER_URL to https://openrouter.ai/api/v1/chat/completions
#   4. Set OPENAI_MODEL_NAME to your desired model (e.g., openai/gpt-4, meta-llama/llama-3.2-3b-instruct:free)
# For OpenAI directly: Use https://api.openai.com/v1/chat/completions and your OpenAI API key
OPENAI_API_KEY=
OPENAI_SERVER_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_MODEL_NAME=
# Optional: Delay between API calls to respect rate limits (default: 7 seconds)
OPENAI_API_CALL_DELAY_SECONDS=7

# --- Other AI Provider API Keys ---
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Analysis Settings ---
# Comma-separated list of music library names to scan. If empty, all music libraries are scanned.
# For Jellyfin/Emby/Navidrome: Use library names (e.g., "Music,Lossless Music")
# For Plex: Use music library names (e.g., "Music,FLAC Library") - case-insensitive matching
# For Lyrion: Use folder paths (e.g., "/music/myfolder,/music/hires")
#
# Multi-Server Sync Behavior:
# This setting affects BOTH analysis (primary server) AND playlist sync (secondary servers).
# - Primary server: Only libraries listed here will be analyzed and added to the database.
# - Secondary servers: When building the track mapping for sync, only tracks from these
#   libraries will be indexed. Tracks outside these libraries won't be synced.
#
# For best results with multi-server sync:
# - Use the same MUSIC_LIBRARIES value if library names match across all servers
# - OR leave empty to scan all libraries (recommended for sync compatibility)
# - Ensure all servers share the same music files with identical file paths
MUSIC_LIBRARIES=

# --- GPU Acceleration for Clustering ---
# Enable GPU-accelerated clustering using RAPIDS cuML (requires NVIDIA GPU)
# Set to true to use GPU for KMeans, DBSCAN, and PCA in clustering tasks
# Automatically falls back to CPU if GPU is unavailable
# Default: false (CPU only)
USE_GPU_CLUSTERING=false

# --- Analysis Speed Optimization ---
# These settings can significantly speed up audio analysis (30+ hours → 16-19 hours)

# Enable parallel track downloads within album analysis
# Downloads and processes multiple tracks simultaneously instead of sequentially
# Default: true
ENABLE_PARALLEL_DOWNLOADS=true

# Number of parallel download workers (recommended: 2-4 based on network/server capacity)
# Higher values = faster but may overwhelm some media servers
# Default: 2
MAX_PARALLEL_DOWNLOADS=2

# Enable async index rebuilds (rebuilds don't block album analysis)
# Index rebuilds are queued as separate RQ jobs instead of blocking the main task
# Default: true
ENABLE_ASYNC_INDEX_REBUILDS=true

# Enable pre-loading all ONNX models at album start
# Reduces model loading overhead by loading all 8 models once instead of per-phase
# Default: true
ENABLE_MODEL_PRELOAD=true

# Download chunk size in bytes (larger = fewer syscalls, faster downloads)
# Default: 65536 (64KB)
DOWNLOAD_CHUNK_SIZE=65536

# Retry settings for downloads (handles connection drops during parallel downloads)
# Number of retry attempts for failed downloads
# Default: 3
DOWNLOAD_RETRY_ATTEMPTS=3

# Base delay in seconds for exponential backoff (2, 4, 8 seconds with default)
# Default: 2.0
DOWNLOAD_RETRY_BASE_DELAY=2.0

# Stagger delay between starting parallel downloads to avoid overwhelming the server
# Adds a small delay between task submissions in the thread pool
# Default: 1.0 (seconds)
PARALLEL_DOWNLOAD_STAGGER_DELAY=1.0

# Voyager HNSW index build parameters (affect index quality vs build speed)
# Lower values = faster builds but slightly lower search quality (~95% of original)
# VOYAGER_EF_CONSTRUCTION: Default 512 (was 1024)
# VOYAGER_M: Default 48 (was 64)
VOYAGER_EF_CONSTRUCTION=512
VOYAGER_M=48

# Rebuild Voyager index after this many albums are analyzed
# Higher values = fewer rebuild interruptions during large analysis runs
# Default: 200 (was 100)
REBUILD_INDEX_BATCH_SIZE=200

# Max album analysis jobs to keep in RQ queue
# Higher values allow more parallel album processing
# Default: 150 (was 100)
MAX_QUEUED_ANALYSIS_JOBS=150

# --- Direct File Access (RECOMMENDED for local media servers) ---
# Bypasses HTTP downloads by reading files directly from mounted volume
# This eliminates network issues (IncompleteRead errors) and is 10-100x faster
# Requires: Music library mounted in Docker container (see docker-compose volumes)

# Enable direct file access - reads files directly instead of downloading via HTTP
# Falls back to HTTP download if file not found at mapped path
# Default: false
ENABLE_DIRECT_FILE_ACCESS=false

# Path mapping from media server path to container path
# Format: "server_path:container_path"
# Example: If Plex sees files at /mnt/plex/music and you mount to /mnt/music in Docker:
#   DIRECT_FILE_PATH_MAPPING=/mnt/plex/music:/mnt/music
# Leave empty if paths are identical (same mount point in Plex and Docker)
# Default: empty (no mapping, use paths as-is)
DIRECT_FILE_PATH_MAPPING=

# --- File Prefetch Buffer (requires ENABLE_DIRECT_FILE_ACCESS=true) ---
# Reads files into RAM ahead of time while GPU processes current batch
# This overlaps I/O with GPU inference for ~10-20% faster processing
# Requires: ENABLE_DIRECT_FILE_ACCESS=true and sufficient RAM headroom

# Enable prefetch buffer (default: true when direct file access is enabled)
ENABLE_PREFETCH_BUFFER=true

# Number of files to read ahead into RAM (recommended: 2x MAX_PARALLEL_DOWNLOADS)
# Higher values use more RAM but provide better I/O overlap
# Default: 12
PREFETCH_BUFFER_SIZE=12

# Maximum memory for prefetch buffer in MB
# Prevents OOM on systems with limited RAM or very large audio files
# Default: 1024 (1GB)
PREFETCH_MAX_MEMORY_MB=1024

# --- FFmpeg Audio Decoder (recommended: 3.3x faster) ---
# Use ffmpeg subprocess for audio decoding instead of librosa
# Benchmarked: librosa.load=37.87s per track, ffmpeg=11.34s per track
# FFmpeg also bypasses Python's GIL for true parallel processing
# Default: true
USE_FFMPEG_DECODER=true

# --- Multiprocessing + Batched GPU Inference (v0.8.0+) ---
# These settings significantly improve CPU and GPU utilization for audio analysis
# Typical improvement: 42% CPU → 80-90% CPU, 1% GPU → 20-50% GPU
# Expected speedup: 2-3x faster album processing

# Enable multiprocessing for CPU-bound audio feature extraction
# Uses ProcessPoolExecutor instead of ThreadPoolExecutor to bypass Python's GIL
# This enables true parallel execution of librosa operations across all CPU cores
# Default: true
USE_MULTIPROCESSING=true

# Number of worker processes for CPU-bound audio processing
# Balance between CPU parallelism and GPU feed rate:
#   - Too few: GPU sits idle waiting for CPU work
#   - Too many: CPU overwhelms GPU, causing VRAM pressure
# Recommended: 4-8 for 16GB VRAM GPUs, 8-12 for 24GB+ VRAM
# Default: 6 (balanced for RTX 4070 Ti / 16GB VRAM)
MULTIPROCESSING_WORKERS=6

# Maximum albums to process before recycling the worker pool (prevents memory leaks)
# The pool is now persistent per RQ worker - no more 5min spawn overhead per album!
# Set to 0 to disable auto-refresh (pool persists indefinitely)
# Default: 500
POOL_MAX_TASKS_BEFORE_REFRESH=500

# Batch size for GPU ONNX embedding inference
# Batches spectrograms from multiple tracks for efficient GPU utilization
# Higher values = better GPU throughput but more VRAM usage
# Tune based on your GPU VRAM:
#   - 256: Safe for 16GB VRAM (RTX 4070 Ti, 4080, etc.) - uses ~10-12GB peak
#   - 384: Good for 24GB+ VRAM (RTX 4090, A5000, etc.) - uses ~15-16GB peak
#   - 512+: Only for 48GB+ VRAM (A100, etc.)
# Default: 256 (balanced for 16GB VRAM)
ONNX_BATCH_SIZE=256

# Use faster tempo detection (librosa.beat.tempo instead of beat_track)
# beat_track() computes beat positions which are discarded - tempo() skips this work
# This saves 2-3 seconds per track
# Default: true
USE_FAST_TEMPO=true
